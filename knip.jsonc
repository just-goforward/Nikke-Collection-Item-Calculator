{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/worker.ts",
        // These exports are consumed by executable Worker bundles and the real Node/browser harnesses.
        "src/certifiedRuntime/nodeClient.ts",
        "src/certifiedRuntime/nodeWorker.ts",
        "src/certifiedRuntime/nodeFixtureWorker.ts",
        "src/certifiedRuntime/browserHarness.ts",
        "src/certifiedRuntime/integrationFixture.ts",
        "scripts/**/*.ts",
        "benchmarks/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css,mjs}",
        "scripts/**/*.ts",
        "benchmarks/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "cloudflare": {
      "project": ["src/**/*.ts"]
    },
    "forecast-collector": {
      "project": ["src/**/*.ts"]
    },
    "forecast-dispatcher": {
      "project": ["src/**/*.ts"]
    },
    "forecast-interactions": {
      "project": ["src/**/*.ts"]
    },
    "stats-observer": {
      "project": ["src/**/*.ts"]
    },
    "usage-guard": {
      "project": ["src/**/*.ts"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "ignore": [
    // Immutable review packets and measured outputs are data, not executable project modules.
    ".tmp/**",
    ".certified-test-tmp/**",
    "tmp/**",
    "benchmarks/results/**",
    "src/wasm/rustRerankProductSolver.ts",
    "src/wasm/rustResearchLoader.ts"
  ],
  // where.exe is Windows' built-in PATH lookup for the local Git Bash workflow fixture.
  "ignoreBinaries": ["rustc", "where.exe"],
  "ignoreDependencies": [
    "cloudflare",
    // Knip infers a package for every testRunner; "command" is built into Stryker core.
    "@stryker-mutator/command-runner"
  ]
}
