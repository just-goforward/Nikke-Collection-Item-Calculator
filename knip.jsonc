{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": ["src/worker.ts", "scripts/**/*.ts", "benchmarks/**/*.ts"],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.ts",
        "benchmarks/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "cloudflare": {
      "project": ["src/**/*.ts"]
    },
    "forecast-collector": {
      "project": ["src/**/*.ts"]
    },
    "forecast-dispatcher": {
      "project": ["src/**/*.ts"]
    },
    "forecast-interactions": {
      "project": ["src/**/*.ts"]
    },
    "stats-observer": {
      "project": ["src/**/*.ts"]
    },
    "usage-guard": {
      "project": ["src/**/*.ts"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "ignore": [
    "src/wasm/rustRerankProductSolver.ts",
    "src/wasm/rustResearchLoader.ts"
  ],
  "ignoreBinaries": ["rustc"],
  "ignoreDependencies": [
    "cloudflare",
    // Knip infers a package for every testRunner; "command" is built into Stryker core.
    "@stryker-mutator/command-runner"
  ]
}
