{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    "src/worker.ts",
    "cloudflare/src/worker.ts",
    "forecast-collector/src/worker.ts",
    "scripts/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "cloudflare/src/**/*.ts",
    "forecast-collector/src/**/*.ts",
    "scripts/**/*.ts",
    "benchmarks/**/*.ts",
    "e2e/**/*.ts"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ],
  "ignore": [
    "src/wasm/rustRerankProductSolver.ts",
    "src/wasm/rustResearchLoader.ts"
  ],
  "ignoreBinaries": ["rustc"],
  "ignoreDependencies": ["cloudflare"]
}
