3-43fe-aa6f-2719ced5e99a\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-390c2feb-3c59-48bc-977c-5174e4d305ad\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-60c21f39-102c-4cc3-938a-c45946e31739\">안녕하세요. </span><span style=\"color:#0078cb;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4de35256-0af2-4429-864a-49b3df8c792b\"><b>승리의 여신: 니케</b></span><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-09ec0e6e-5876-4b87-b857-703f8150a66b\">입니다.​​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3eccb20d-64a2-46f8-8fee-cbe7b230ab66\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0eeaffdd-4596-4225-892a-345c7fcbe8dc\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b6d50856-1266-48db-894f-959aa34936b1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6dca0d28-fba7-4b7c-a7f1-80bda42ee249\">9/5(금), 무점검 업데이트가 진행되었습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fbe906c5-4a49-47e0-869c-55e04999d2d6\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a23cebe8-f899-4bc4-b4bc-0e517bbaa3a6\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-10ed4d74-f49a-4ba9-a072-e01e44a831fb\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0dff90c4-b4b2-411f-ae86-814b07763739\">게임을 완전히 종료하신 후 재접속하여</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0c3f6161-34f4-4b84-a05e-eed8d5496331\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ca5b38ae-fd4c-4c96-907d-a9f77ba33e35\">업데이트 리소스를 다운로드해 주시기 바랍니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0e2c5369-9012-4a5b-81f9-9e07d2ff9cdd\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-e7716390-3df8-46cd-9bcf-b4d60a3f882b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9ee852cd-5510-4281-a462-2e2d2c21916d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-94bf1dfc-23c5-4879-a217-2e2c856b1a1e\">​​자세한 내용은 아래를 확인해 주시기 바랍니다.​​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-96d8b79a-b1c4-4a99-99f4-d44367d127d0\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0971efbe-ab69-446f-a208-85530536101d\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4d511bae-05bf-460a-b6ae-23eb88594881\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-9ff71fa9-056d-4353-b1db-70c423b4a99f\">​·····················································································</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-eded7db0-b05a-4132-b2b3-c2a2ce806306\"><span style=\"color:#000000;\" class=\"se-fs- se-ff-nanumgothic   \" id=\"SE-068e6b2c-603a-47cf-9e28-17135c5c493d\"><b>📢 9/5(금) 무점검 업데이트 안내​​​​​​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5ec9acd9-f712-46b8-b574-6b69069294db\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b4061395-1f80-44eb-8048-be91118d4736\"><b>​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9d5ae3ee-d022-466d-b59a-86f085c24e80\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-096a7950-4b5a-46b4-ae73-96a314a3fe23\"><b>​✔️ 일시</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-211478b3-947b-4a12-95a5-07ee9db47d36\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-e54f80e3-a677-409e-99ef-9f701ba0a6e1\">- 9/5(금)</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-17e1df89-355d-4ea7-8b74-aadaa185f62d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-1e77d93e-d9fb-46cf-91b8-bfefeed12cd3\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-390eb1eb-6194-4e46-8423-a2ace32edc61\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3252fa0f-5875-44cc-9c2c-5937826eaf24\">​</span><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-885742c9-bc66-45bf-8b4d-47948e376ad3\"><b>✔️ 내용</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9fd539e7-0c5c-4b1b-b757-2f2dc4ffcf82\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c6176e38-1a4e-4cb0-9117-838239cccba1\">1. 스킬 컷씬을 [간단히] 옵션으로 설정 시 재생되는 연출을 원복하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-816f0ae0-d176-4bc1-9295-5e34696d1641\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-54680d65-204d-474a-8a85-24fd0f3ed528\">└ 연출 중 니케가 스탠딩 자세로 등장합니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e11ce993-4f84-4c22-a335-1fc2309d8f76\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3aa227ed-9875-4a73-b7b3-dbca66bcd081\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-00ea1905-03cc-4432-a30f-9e659a8a9efd\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-f3ce9c7d-81bb-478e-ab76-5e5fae050535\">2. 애장품 미션 스테이지의 전투가 정상적으로 종료되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-38cc9325-0e68-4ab5-b15c-f7229a507e65\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8724699a-3f50-40e6-a33a-43be736cbfb2\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9c483f1d-583e-4482-8608-66af9c9550fb\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-18cf7d1b-363b-4d71-8f5d-12434bd2144c\">3. 캠페인 20-31, 22-36 노멀 및 하드 스테이지의 전투가 정상적으로 진행되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f35a90b7-60a7-4d9c-a895-4630b1a941ba\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-165dcfac-aa87-4c47-a3d3-17dc8ffa2b7e\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5b1e296f-67a7-43f7-b2fb-07059ea92dd1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c8c22917-fced-4aa2-a92c-d5236a1376f9\">4. 기간 한정 선택 모집 기간을 [행운의 바니걸 혜택] 우편 수령 기간과 통일하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0a0b909d-4402-4e68-b677-618ab417220c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-743f3d6a-c6eb-4cd2-8c30-971a8b1b9e9a\">└ 기간 한정 선택 모집에서 획득 가능한 니케는 변경된 기간 동안 마일리지 상점에서 골드 마일리지 티켓으로 획득할 수 있습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-85c355d2-8444-4e3b-af59-26b1953f3e0c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-89aa67db-e068-4bef-b6e2-9b5b0d8d77b1\">[기존]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-68ebed3e-0411-4414-8a0a-5d09e2653634\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c0ab49f6-286f-400d-9750-60ba7f3137a6\">└ 2025년 9월 4일(목) 점검 완료 후 ~ 2025년 9월 23일(화) 23:59</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cebd1227-f56f-4734-ae73-1d4ba7867828\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bea3726a-3ea9-4a7f-8d06-62ed2c06c776\">[변경]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0b3e9407-16a4-4935-92ed-210b1de67510\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c98da3fa-11c1-4ee6-b045-0e3fcbd651cd\">└ 2025년 9월 4일(목) 점검 완료 후 ~ 2025년 9월 25일(목) 16:59</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6f089cbd-4ff8-45b9-9e4b-01d7ea4fdb07\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bf285129-66f5-461f-8a3d-16155764bd46\">[대상]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-28497443-105c-4e5d-ac91-1e85667876b9\"><span style=\"color:#000000;\" class=\"se-