      "contents": "<div class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    <!-- SE_DOC_HEADER_START -->\n    <!--@CONTENTS_HEADER-->\n    <!-- SE_DOC_HEADER_END -->\n    <div class=\"se-main-container\">\n                <div class=\"se-component se-image se-l-default\" id=\"SE-e29c5531-cfcd-4231-8658-d5248ff8e9ea\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:800px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-e29c5531-cfcd-4231-8658-d5248ff8e9ea\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA2MjNfNjcg/MDAxNzUwNjU3NjU5NTY0.X64mZlvXVUGxaOM1GuK77qrCZ3iIyqLZtGPNvlSpFBMg.7sbPpf1CNpF09s4tNwNCc9Lo8eBSctESOIY4VRhdG-kg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\", \"originalWidth\" : \"800\", \"originalHeight\" : \"236\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://nng-phinf.pstatic.net/MjAyNTA2MjNfNjcg/MDAxNzUwNjU3NjU5NTY0.X64mZlvXVUGxaOM1GuK77qrCZ3iIyqLZtGPNvlSpFBMg.7sbPpf1CNpF09s4tNwNCc9Lo8eBSctESOIY4VRhdG-kg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-e29c5531-cfcd-4231-8658-d5248ff8e9ea\", \"data\": {\"ctype\": \"image\" }}'></script>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-4180082e-71e4-481d-a15f-2cf3de1374bc\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-71816404-724b-49b3-9fc9-15eae14ebc1b\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ea486207-5441-48e3-83b9-b1b3ba30f08b\">안녕하세요. </span><span style=\"color:#0078cb;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-1c8dfaf3-9f0d-4a0c-9c54-5dac88beb918\"><b>승리의 여신: 니케</b></span><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-dc480bf6-cac7-4cbf-95bb-c0f64efca398\">입니다.​​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5e2838ed-8904-4c0f-ac97-153952e266b0\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3792bae7-260b-4369-83fd-6fe869a43a19\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4d1a9fc1-2ec8-4686-91a0-b31fa92c3be8\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-7a7fe3c8-7ff0-4a1b-bff4-e4741e35a27e\">6/24(화) 서버 점검을 통해</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e3d96582-c2cd-4718-b70e-b841be8020b8\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6225d186-cc97-4c44-884f-1624fd50fc24\">다음과 같은 업데이트가 적용될 예정입니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8f4ba819-9089-4e31-a269-7720549ca93e\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0bbd97c5-2deb-445d-b730-8c4ed6e50ad9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d4729878-690c-436b-8293-50a35570ca15\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2d5546ca-cfa1-4534-8c3c-e22984015a1c\">​​자세한 내용은 아래를 확인해 주시기 바랍니다.​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-55d3d4fb-71a9-4c1f-acda-34f711951ce7\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-7c952d36-114c-406f-9e79-58dee2ca3d23\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-632f037f-d8d3-4ae6-bf48-7589c8653d8f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-442d8331-c71f-45ad-b892-68591307cefa\">​·····················································································</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-77411608-3bc3-430e-8dcc-30e8b7b9c764\"><span style=\"color:#000000;\" class=\"se-fs- se-ff-nanumgothic   \" id=\"SE-89b05c0d-d44e-4e62-9f2c-098c965f1fe5\"><b>📢 6월 24일(화) 업데이트 소식 사전 안내​​​​​​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-33003a43-7dbb-4ee4-b7db-fd57691db3f6\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3ff8de59-1a2f-4c66-82ef-1b7fe70357e4\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-51963cad-81ca-49bf-a3a6-63caddec33e5\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4eb28a4a-5024-41cc-a497-f34ce4e7b287\"><b>​✔️ 일시</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2b67ca3b-84a1-4d25-aa32-4ec0ea9392be\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6a5e68f0-356d-4211-8762-1fdefa9552b3\">- 6/24(화) 11:00 ~ 16:00</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7fa54665-e4a5-442f-8fb5-692b4305e029\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-da6d29b1-e646-472e-a0ca-9e6c79f2ca7c\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bc351471-d040-4bc7-ad2a-852aad5a1003\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8a497f47-d857-46c5-b4db-0f4b95c83bc9\"><b>✔️ 점검 보상</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a3f1033c-f2c8-4581-8627-c87b4d61d46f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ea3c574c-dc74-42b1-acbd-c98a3ae04967\">- 300 쥬얼</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c982e68a-1669-44bb-9f10-802907f3e900\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5882199c-619f-42cf-bf54-12d55bad84d2\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0427aaea-37d0-4a98-8edc-d34e99bbfa08\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5b63fb02-4463-4984-847c-6c2e99befa95\"><b>🚨 주의사항</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6ff35b44-0f2a-4082-ba07-4f18bb8ec990\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-1c150df8-3ef2-4c60-bec4-a15fdce530ae\">- 점검 진행 중에는 서버 접속이 불가능한 점 양해 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b6facbfc-795e-49f5-93c6-76de6f4a4800\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-fd8d7de9-d27c-4be2-9856-fcaf9f2b27c8\">- 원활한 점검을 위해 진행 전 접속을 종료해 주시기 바랍니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-90097127-bd76-4e21-aeee-15f355b87438\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8c4b567e-46ae-46a9-b7fe-6d760d609e03\">- 업데이트 후 스토어에서 최신 버전 클라이언트 다운로드를 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7e16aba3-1923-4559-90d6-c247b6c0d6a7\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-de36925f-db0d-4cab-af08-ea80ee4337ee\">- 신규 클라이언트 다운로드를 위해 디바이스 내 최소 5GB 이상의 저장 공간 확보를 권장드리며, &lt;승리의 여신: 니케&gt; 게임을 처음 설치하시는 신규 지휘관님께서는 최소 10GB 이상의 저장 공간을 확보해 주시기를 권장해 드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-af932e1c-586b-44e5-9921-0352d5977aea\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5f454ef7-2135-4534-b109-b724e951179e\">- PC 버전의 경우, Launcher에서 [게임 시작] 버튼을 클릭하면 최신 클라이언트로 업데이트가 진행됩니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ff71bdce-6b7b-4609-bfc9-9bf423dd73c2\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8f3c667b-eed2-4626-8a02-f20c85125f7d\">- 리소스 파일 다운로드 과정에서 게임 앱을 강제 종료하는 경우 클라이언트 리소스 다운로드에 실패할 수 있사오니, 다운로드 중에는 게임 앱을 강제 종료하지 않도록 주의해 주시길 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-04fd1ccf-9ea2-450e-b8d8-3d44a6278189\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-7245d293-5561-47cf-8e17-7786f00ba81f\">- 내부 사정에 따라 업데이트 내용 및 점검 일정이 변동될 수 있으며, 변동 시 본 공지 사항을 통해 안내해드리겠습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8368c404-6f15-4ec5-86d8-3fd5436e05e2\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-75edb318-901c-48db-9f1b-242f87d2f87f\">- 점검 종료 후 연장되는 시간에 따라 점검 보상이 추가로 지급됩니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-11943f40-94a4-4e6a-8272-5e0022ff0ccb\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-acce02d3-3249-4446-bc6d-f389419e8db0\">- 점검 보상은 점검 종료 후 계정당 1회 지급되며, 네트워크 지연 등으로 인해 지급이 지연될 수 있습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9d1a1bf4-253d-47e3-a567-141eb69f91ec\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5a55869d-f8d3-4c4e-b52d-9f64b018bd23\">- 인앱 구매(확률형 아이템 포함)</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-4180082e-71e4-481d-a15f-2cf3de1374bc\", \"data\": {\"ctype\": \"text\"  }}'></script>\n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-332275b1-47fe-4754-b2af-ae432a61cf22\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-ade2600b-8f29-4cc5-a6f2-874738abdb90\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:700px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-ade2600b-8f29-4cc5-a6f2-874738abdb90\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA2MjRfMjc0/MDAxNzUwNzQ3OTc3Mjc1.tSuZBKo9gpecfMQ1v-X91v6KXPjnK0JxPnZ3SDmF14gg.fz36ZvD1BUmm8Ck9Zd-Tb77TPazi0pRR_l_juv0B-d8g.PNG/%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_%EB%82%B4%EC%9A%A9.png?type=w1678\", \"originalWidth\" : \"700\", \"originalHeight\" : \"50\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://nng-phinf.pstatic.net/MjAyNTA2MjRfMjc0/MDAxNzUwNzQ3OTc3Mjc1.tSuZBKo9gpecfMQ1v-X91v6KXPjnK0JxPnZ3SDmF14gg.fz36ZvD1BUmm8Ck9Zd-Tb77TPazi0pRR_l_juv0B-d8g.PNG/%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_%EB%82%B4%EC%9A%A9.png?type=w1678\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-ade2600b-8f29-4cc5-a6f2-874738abdb90\", \"data\": {\"ctype\": \"image\" }}'></script>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-25651e82-e0e6-48ac-83dc-cc47565b2b96\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2e282a28-325c-4cf6-9732-9cd00c4e86f0\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-de54030f-7dcd-4cc6-97d5-adfaa2ebe7ee\">1. 미니 게임 NAYTIBA RAID에서 WB 펌프로 부활 시, 연출 중 전투 시간이 소모되지 않도록 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-82355fbc-e031-4ea9-8985-92bdce047248\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-db0aa215-c304-4db9-bbed-a279412b6d78\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f44db5d7-3130-4e64-88c7-6aa10fcb3aea\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c59c9362-2d59-4202-a7b1-b52613bc97b9\">2. 미니 게임 NAYTIBA RAID에서 특정 조작 시, 결과 화면에서 획득한 보상이 표시되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-45db98c8-07bc-4e2b-9d2d-1c343d3bdcfb\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-305688c1-a670-4623-9a8a-ea2e499edf57\">└ 실제 보상은 정상적으로 지급되었습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4c8318ea-2c1b-4401-a8ed-79a8d71822ff\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a63835d3-5077-4820-8dcd-865864cee582\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-34c8d860-ac0a-4e3d-8c82-f10f59747c1d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b4e174f5-9acb-4f8f-b075-c567fe9f463a\">3. 미니 게임 NAYTIBA RAID의 결과 화면에서 클리어 시간이 좀 더 상세하게 표시되도록 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a8704310-e15a-435d-a1b4-09f89d10a755\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2137c386-80b1-4596-a06c-fc55d05925c8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f09648a7-6d62-44db-8b91-0661115bf8af\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-93a716d5-8456-4e7e-839a-808d72c1f363\">4. 미니 게임 NAYTIBA RAID에서 스킬 WB 펌프를 습득 시, 특정 상황에서 골드를 추가 획득할 수 있는 현상을 수정하였습니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f16213ae-caec-4c69-be1c-abe162ca931a\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5e741808-f58b-456e-8a24-8afff8e3b9ac\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-32342f16-a616-4acd-81c2-de5ee4c8fb8c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-1f23a7ea-6114-4c94-9169-361ea9be677a\">5. 센티 - 오션 리페어의 스탠딩 포즈에서 특정 부위를 좀 더 자연스럽게 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-496d3628-808e-424d-86e5-64ca624240c5\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-9df5e53c-deae-4e02-b5cf-960ade016d09\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-30719fbe-94ad-4682-b192-5e11a483e4e8\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ed5603ab-5b22-44f5-a5cd-6413ff80b9d5\">6. MEMORIES TELLER에 등장하는 콤의 디자인을 통일하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-82102971-a951-4c4b-85df-b182f669d6d6\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-f3c90718-c034-4d10-a7fa-afde9c0650c9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fd92edab-e926-432b-a3b0-cadb30277a46\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-27dfccac-f868-4ca8-a7bb-96f51c9a482c\">7. 협동작전 도전 모드 전투 진입 시 간헐적으로 경고 팝업 창 출력 또는 강제 퇴장당하는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a6242693-492b-4b49-8199-ba8a98a4fcb5\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-104bd4fa-099d-433d-a27c-99f4474d9ecf\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a156999a-75cf-453e-b4cb-1d4e63d7c80a\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4625ad35-375c-49d0-8e60-37ed24eb7d2e\">8. 일부 언어의 로컬라이징 이슈를 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ddd5f76a-b176-4ef4-aa09-841bc392d0dc\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-efdf75ef-3d3e-425a-b06f-9e1e59623601\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c568bb1a-1468-491f-8549-80ac76c5914b\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2d2be991-b7e3-4f99-ad61-f593b84cf0b0\">9. 일부 보스 전투에서 저지 패턴 유지 시간이 비정상적으로 짧은 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c0935cf2-6a28-4f4c-91ac-e0934d651784\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8b1560cd-d5bf-46cc-abfd-446fb9cc2e40\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a5979e60-75a4-4621-bc49-bdc66fc3dd22\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-f912d1f3-a483-4bc4-a06c-cdf3e27ccf79\">10. 협동작전 도전 난이도에서 RL 무기 니케로 전투 시 특정 상황에서 경고 팝업이 표시되는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6e6dc35d-696a-4a8d-a73c-b17110b4e7a4\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3f7fd5a9-8d37-457a-a1ce-79697bccb83a\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ec9a62ae-6653-4be0-88b0-aff3cca5b4c8\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5eca7fb1-eced-4730-89b2-0a3f6d63a89b\">11. 미니 게임 NAYTIBA RAID에서 일일 미션 [대미지 n 입히기]의 달성 조건이 의도와 다르게 동작하는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-50c407cc-a937-4e84-b0a8-b0f559b9b0ed\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-28a12779-a493-4620-b04a-75fd35edf3c0\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-843c4160-ba6e-4619-9aab-41f59891d6da\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-55f12101-d66f-482b-92e6-c878baf49ace\">12. 설정 - 전투에서 [버스트 스킬 위치] 옵션이 [왼쪽]일 경우, MEMORIES TELLER 스테이지의 버스트 스킬 UI 디자인이 의도와 다르게 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ab565783-5e9f-4159-870c-5e6954be28d4\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a4d22a1c-89b0-4d7f-acab-71fcbddbfa11\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-1fd17e2f-5065-4b2d-8139-d9264a867a43\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5e3cadc2-9668-4802-a5d2-ffd9f6e1e265\">13. [스텔라 블레이드™ 컴플리트 에디션]의 코드로 「홍련 - 레이서즈 하이」를 획득한 후에도, 코스튬 픽 뽑기에서 코스튬이 보상으로 등장할 수 있는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dfd802f8-33da-4fac-b324-136293f236eb\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-d31d5b92-afc4-466e-b1f0-a49398924b76\">└ 해당 상황에서 동일한 코스튬은 중복 지급되지 않습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f71b0f29-0f83-4145-b28c-8e4f84b68e9f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c6c19b7f-4ade-4e09-8071-f7be234569d4\">└ 코스튬 픽과 관련하여 도움이 필요하신 경우, 고객센터로 문의하여 주시기를 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-382adfaf-bbc1-45ac-9d3f-cdb2b1e23e54\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8712f79c-42ea-4cab-ab6f-ff885c844fb6\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-61775f1a-c92d-4abd-b6b3-9a24baf5311f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6dad7339-0a44-4981-84d3-016a6a508fc8\">14. 미니 게임 NAYTIBA RAID의 조작감 및 난이도를 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3f4de596-1129-4d70-9d6a-28cdf058f402\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a1086e70-cd73-479b-afd6-beefc7ebc404\">└ 보다 편하게 스킬을 사용할 수 있도록 스킬 버튼을 터치 시 마지막으로 사용된 스킬을 사용할 수 있게 개선하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-039bb78d-fdfa-459f-ba58-1c1a74e4c76c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-257aff12-2214-4568-b6c4-2d4db323ae2f\">└ 연계 공격 시 전진하는 거리를 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dfa21161-c74b-44fa-b934-91fab0a53cec\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-29b03cc8-4864-4818-b6de-f7751a095278\">└ 이동 편의성을 위해 닷지 시 이동 거리를 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dec25f66-57f8-4f2b-a5b1-4f6111146c34\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0b7a0166-c90d-4ef5-b8e5-53c35a2343b8\">└ 특정 공격 중 즉시 닷지, 가드, 스킬을 빠르게 사용할 수 있게 개선하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-19a246a4-f6cb-488a-8081-6f3e08229fe6\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b28d55fb-9f13-4ab3-bb30-4e1d655b29ef\">└ 퍼펙트 닷지 및 가드, 블링크, 리펄스의 성공 타이밍을 보다 쉽게 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cbae47c5-09d6-4bfa-82af-46e49d238671\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-63447adf-d945-4ba4-a50b-adb8123d0a6b\">└ 다운된 경우 좀 더 빨리 기상하도록 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-60a4bc7b-3ee4-4710-b491-769b7b6f9dff\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c5eaa0ac-acf6-4ac0-8553-020e85b7d895\">└ 보스의 실드 게이지가 회복되는 시간을 대폭 늘렸습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9156a9ae-2cae-408d-ba16-545e462a278d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bb1485b4-f770-4dd8-aad4-d00980bbb2ee\">└ 텀블러 사용 시, 이브의 HP 회복량을 상향 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ab289ee8-1d6b-4ddf-b93a-b5d0eac20663\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a57bc4e7-7daa-45c2-886c-dd156c9d4794\">└ 미니 게임 NAYTIBA RAID 노멀 난이도의 기가스, 아바돈, 베히모스와 전투 중 주요 시점에 전투 관련 도움말이 표시되도록 개선하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3b5c398d-6c56-4281-9d13-29593046b146\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-0c89e087-5b3c-4668-8a3c-bfd7870128b5\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2e5e14dd-cfc9-44bd-96c0-7ddf659c6277\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-abdbec36-2498-4198-9890-49d8c42cfbba\">15. 원활한 게임 실행 과정을 위해 진행되었던 로직 개선 내역 중 일부 이슈로 인해 특정 상황에서 화면이 끊기는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8fdbc05f-7d36-4242-b98b-b834d14cbc07\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6a677019-8d5b-46e8-8394-b8009a3332b8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4a789dc0-7f3f-4498-ad30-4c874c24be82\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-d7efc0f5-b0f2-44cf-9e3b-4b4877a0c87f\">16. 주크박스에서 특정 BGM 재생 시, UI가 어색하게 보이며 다른 음원이 재생되는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-224b796c-23e3-48c5-aac2-a0db7080baca\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a7aa7078-1321-4a8e-bf64-69a619175ebf\">[대상]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7b3a9533-d76f-426a-a669-ac71798f8928\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b4751779-2b7c-4b6b-945a-89de567c7627\">└ Hall of Records</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f8c22ae3-c9ad-4ba9-b6c0-d42a813efaec\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6bd430e8-eae1-4408-8fb6-d944b946375b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7ac5bfa6-c72e-4f2e-a63d-a524643c3838\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-be677071-cfae-4e13-aac3-cff61c44001c\">17. 스토리 이벤트 MEMORIES TELLER의 특정 이벤트 씬에서 어색하게 보이는 부위를 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-01995425-e6bc-4f17-8318-2b8a7910f64b\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-45beee66-b46b-4d99-bf60-570995748749\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b449a346-2776-4fe0-ac83-7f8542046838\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b9f4dcc1-314a-4a6b-b66c-6c12ea2e8c60\">18. 레이븐 스킬1 「쇼크웨이브」가 의도와 다르게 동작하는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-238e7670-8521-4279-95fe-08b041ceb0c0\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a7a9ac04-9e8e-4245-a43a-4baaf8a39d4e\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e63fa423-1950-4044-b651-c4e0b7eb22c4\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-beec9c12-db84-4d02-8985-844382dd2c72\">19. 미니 게임 NAYTIBA RAID의 스테이지가 지정된 일정보다 일찍 해금되는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c44f05d4-dbf1-469b-bf7d-5af5456565c4\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6de8e067-6ed4-487d-a8cf-ad2216e4b270\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-98258fb9-2efd-4924-95f3-6a0070b33d4d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-737d2c06-c707-441b-8c7a-08567d6e5b4b\">20. 스토리 이벤트 MEMORIES TELLER 기록 보관소의 회상 목록 순서를 실제 이야기의 흐름과 일치하도록 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-595add5e-55fc-4a2f-b1d3-5ab82cdc017c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c10f0ec6-9016-48e7-8bcc-f5cd6c472d6e\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dd22d5dd-2d8e-4e5e-a5f8-2197a29b2076\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c43deb62-5a7a-4865-aa57-f7b7ae334638\">21. 일부 이슈로 인하여 요격전 완료 정보 화면의 클리어 정보 조회가 일시적으로 비활성화되었습니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d8791116-3599-42f7-8917-dc47850c0518\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c3dce5bf-f29d-48c1-b11c-097f34eee549\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b863c9dd-9a72-4f23-b8ce-11403c5f1553\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-f0701b21-d5cb-4cc8-82d0-2fd3b3d6bd39\">22. 솔로 레이드 시즌 26의 진행 일정이 변경되었습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-25065595-8d61-4fca-bdb7-d0409d0d3b01\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-cbf1ffa1-fb23-491d-8d07-586b4602c6db\">└ 2025년 6월 24일(화) 점검 완료 후 ~ 2025년 7월 1일(화) 4:59:59</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-adee2470-869b-4389-a4d1-9e58cb5a823f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-9b2d7b79-03c6-45dd-972f-79e55c973f51\">·····················································································​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4d005c36-62ac-40b1-bb78-5bf444a2e5ae\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-59d089ef-3d96-4377-8c86-532a6d21df95\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e0e06fe1-d8a6-468a-a6c1-8f20b826dd01\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-61901a0c-24ff-407d-a1a0-1d4ef39200f7\">게임 이용에 불편을 끼쳐 드려 죄송합니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-25651e82-e0e6-48ac-83dc-cc47565b2b96\", \"data\": {\"ctype\": \"text\"  }}'></script>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-9b3ce63b-9b2c-4e10-ab38-9718420eb4a8\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:100px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n 