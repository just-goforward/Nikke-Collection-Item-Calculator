      "contents": "<div class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    <!-- SE_DOC_HEADER_START -->\n    <!--@CONTENTS_HEADER-->\n    <!-- SE_DOC_HEADER_END -->\n    <div class=\"se-main-container\">\n                <div class=\"se-component se-image se-l-default\" id=\"SE-d7af8d9d-fa5a-43d2-ba21-b53fda9076f5\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:800px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-d7af8d9d-fa5a-43d2-ba21-b53fda9076f5\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA0MjRfMjAg/MDAxNzQ1NDk3MjY4NzQx.STw9tl0v_Wt7NyqGin3iu_KcEFR1zVpLflKzHIniw6wg.Cm0zO-KMrsKi1wCzVoihrzXsRvBxWLZ5xxFVWCPX1n0g.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\", \"originalWidth\" : \"800\", \"originalHeight\" : \"236\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://nng-phinf.pstatic.net/MjAyNTA0MjRfMjAg/MDAxNzQ1NDk3MjY4NzQx.STw9tl0v_Wt7NyqGin3iu_KcEFR1zVpLflKzHIniw6wg.Cm0zO-KMrsKi1wCzVoihrzXsRvBxWLZ5xxFVWCPX1n0g.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-d7af8d9d-fa5a-43d2-ba21-b53fda9076f5\", \"data\": {\"ctype\": \"image\" }}'></script>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-e1edc78d-fa46-4f0d-9c42-3e2a0c314b45\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7172318b-f25f-4e42-9f27-25966ff6b742\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b78df03c-4165-432e-992c-956ad6ea05b7\">안녕하세요. </span><span style=\"color:#0078cb;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a38aecbd-fe37-4811-b3ae-ca84bc0f8ca1\"><b>승리의 여신: 니케</b></span><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6e4b89ff-24b2-4e09-84b6-f32f5a049fbf\">입니다.​​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-735a96c3-fadc-4c30-9478-5f73ae42134f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5b8e5ace-3203-4b65-8565-41d11cf93633\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8f5961fb-2ec8-421e-a375-23c171a7c717\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-91cd46f4-69be-4bc1-8f2c-61dcaa038222\">4/24(목) 22:30 경에 무점검 업데이트 및</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6d08fa83-14dc-4d86-b37d-845b317bb5d1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5ec86ce1-9c1c-41db-8473-76ac13660faf\">업데이트 리소스 다운로드가 진행되었습니다.​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fceaa5c9-4b21-47e4-a26d-6ddee0faba86\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-d1e25413-67a8-471d-adc3-d0cdbf352b48\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-25e3d34d-ecec-4f59-b9da-81e30a97291f\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-86f60584-c6a8-4f6d-9142-ff7d74a67989\">게임을 완전히 종료하신 후 재접속하여</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4c963c4d-96d5-4fcd-8e61-835cefe69790\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3b670d6b-c196-4142-b736-5c51ae50ff4c\">업데이트 리소스를 다운로드해 주시기 바랍니다.​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e9a975b8-1c36-4a4c-82ab-0029c5bf27b9\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bff8ce7a-c4f3-420c-b957-f50698f38e8b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7531ca4b-87ab-41bc-9a0f-28e00f101540\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-e3da73e9-d7fb-43bd-802c-a04e489dc7ed\">​​자세한 설명은 아래를 확인해 주시기 바랍니다.​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-287141e8-18ae-4426-b7b1-10a217403181\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-509f18b4-b690-41e6-b7cf-2532fbd2cf96\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-851a13ae-87be-4058-8fe7-3b76b439eff1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-51dc04bd-0f01-46ee-a73e-b8d3f8a4500e\">​·····················································································</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-19bcaa6d-809c-4169-8ea1-db3070b25420\"><span style=\"color:#000000;\" class=\"se-fs- se-ff-nanumgothic   \" id=\"SE-c2195ccf-7669-4089-923b-8caaba17b3ec\"><b>📢 4월 24일(목) 무점검 업데이트 안내​​​​​​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-80f566ab-d31d-4a33-9270-991fc87d1fdb\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-666c5927-ed87-4a38-af94-427e1eaef8ce\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2ec3262b-095d-4a81-a0d7-1723901d9cdf\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a3dd7a60-6f0c-4836-9a30-188f24a5899c\"><b>​✔️ 일시</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-de545d3c-6d95-4ad0-aa1d-f6f6c5b1f402\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-edd42893-e8ad-4b26-b739-fbc2df602d08\">- 4/24(목) 22:30 경​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-de9b326d-8115-4d4f-9bab-1b4f4455720c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-c0961cbb-c7d0-4b14-b7c1-63f8985b9970\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-183bd395-3ebb-48c6-8b59-aa23603130c3\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-aee49a79-f64b-46bd-91f2-3f09ad3cc45d\"><b>​✔️ 내용</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cdb63602-0723-4ca7-a87e-7db24da47592\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8a90ce66-71c8-4b65-9b96-c87a4e62c7ec\">1. 캠페인 38챕터의 일부 노멀 스테이지에서 의도한 BGM이 재생되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7d753581-19af-4a23-83ae-4774e108d170\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ea707a95-73a1-45e9-86f7-5ab9b926d57c\">2. 그레이브 - 뷰티풀 유의 전투 모션 중 특정 부위가 어색하게 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cf7e6071-08f7-4d30-a2bc-cc1e175071ec\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2edfa984-241c-4c7e-908f-9049b8dc78a5\">3. 리틀 머메이드와 리틀 머메이드 - 어비스 플라워의 전투 모션 중 특정 부위가 어색하게 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b2158e94-d61d-49a2-834b-6524cf8f2b65\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-249617ed-93eb-41aa-ac6f-62d7ddd0e338\">4. 리틀 머메이드 스킬1 「버블 오더」의 [사격 집중] 효과가 일부 니케에게 적용되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-726c3aba-84dd-4136-af29-b72768481130\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-68b63b3c-96fd-4b3a-95be-6a2f336b1e3d\">[대상]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-663d9da1-1c99-4e39-8933-bfbc76fa8d82\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-33be7de2-796e-4b55-aaec-cb85bc52e427\">└ A2</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b5ebbb6f-8280-4409-bd0c-4d3a65e182b4\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-03bbb019-59b9-4ba0-a987-3c0a398d4bf7\">└ 홍련 : 흑영</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5eb3b6df-7a54-4ff9-a281-39a6dbaec9b5\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ca5e28e3-0f09-4509-bb1e-ed65a6352773\">5. 이벤트 필드 UNBREAKABLE SPHERE에서 특정 연출의 재생 간격을 좀 더 자연스럽게 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bf493c56-589b-4bb7-8232-d3c63cc4c54a\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-9a6d9a54-5294-40f3-9ecc-c03bfcd69cc2\">6. 메인 퀘스트 시나리오에서 특정 캐릭터의 스탠딩 모션이 어색하게 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b3ea9691-48aa-4f0c-b183-8c477b1c9599\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-12a98f1e-51f5-46ec-927b-f6791166595b\">7. PC 환경의 필드에서 리틀 머메이드의 이동 모션이 어색하게 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-128629d8-cc2c-43f0-b4a5-e1a649f9534e\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2495215e-cec2-4975-9446-d717ca4ff19b\">8. 모집 혜택 이벤트에서 일부 문구를 좀 더 명확하게 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f2e5ccb1-6947-43d0-9a99-4440a17b3bab\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ed1b914c-8908-4dae-8df6-f6783b0e0807\">[기존 → 변경]</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d9f4c8a3-fb7b-4a56-af13-3ca7f12ad6d5\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a4b1610b-2094-4363-ae38-a76455810873\">└ 니케 모집 진행 시 → 각 STEP마다 지정된 모집 횟수 진행 시</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4839486c-2e68-4e8f-8217-8668a6d92932\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-72941d51-12b8-4e20-bf2b-f3aa55d4f74c\">└ (이벤트 팝업 내) 보상 획득까지 n회 → 현재 STEP 완료까지 n회</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8643c45a-fcba-4dcd-b2c9-2768a4a9aa8c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6dc0035b-4f67-4f36-9ebd-d50c81cadb57\">9. 일부 계정에서 PASS 이벤트 - ROAD TO VILLAIN의 칭호 보유 업적을 달성한 후, 보상 수령 시 에러 팝업이 표시되는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-83c53239-946a-425c-9918-a804d5286928\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-9f872689-30a8-4bf3-ac8c-795b0d27011e\">10. 일부 언어의 로컬라이징 이슈를 수정하였습니다.​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5f26fd45-43ed-4df4-ab7b-1169d7904c56\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b4bc4edb-b723-4dcb-a9a2-bba7f11f43c9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a3e67fc7-39d8-4cc0-903f-8d70bfdc7d96\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6f6f8514-ea2a-45ec-9076-a492ee6ce1f5\">​​​※ 게임 재접속 후 업데이트 리소스 다운로드를 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a7caff01-1e83-41bc-a9b7-30f94f47861f\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-062b6336-098b-4a41-a22f-1e3e9cde842f\">​※ 인앱 구매(확률형 아이템 포함)​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ee36bd62-cb06-4512-a9e0-8c29a5d960b1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-af6fb63a-ac3d-4e58-8e8c-f88322c360e2\">·····················································································​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ab599b1d-c0a8-4062-a233-f9369d5bf218\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-ed6dcceb-1eea-4410-a579-df5410779ae4\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c7ecf5a4-c381-40cf-a58d-5ea5be3dda57\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bdb2ef79-d33c-445d-b1b1-d39946e0e255\">게임 이용에 불편을 끼쳐 드려 죄송합니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-e1edc78d-fa46-4f0d-9c42-3e2a0c314b45\", \"data\": {\"ctype\": \"text\"  }}'></script>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-ee66ff53-d36f-4ba0-8476-62e7c0de1aef\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:100px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-ee66ff53-d36f-4ba0-8476-62e7c0de1aef\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA0MjRfMTk4/MDAxNzQ1NDk3Mjc1NTA3.PGwhLsbrZOuGsbWUrTogi6Zrg8cq0xlNtnPSTm4OsWEg.iuCR07QxCsb25eMkmpvxZHF0NeuUay_MzBIaDemTkBgg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_100x100.png?type=w1678\", \"originalWidth\" : \"100\", \"originalHeight\" : \"100\", \"link