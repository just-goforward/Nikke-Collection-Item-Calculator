      "contents": "<div class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    <!-- SE_DOC_HEADER_START -->\n    <!--@CONTENTS_HEADER-->\n    <!-- SE_DOC_HEADER_END -->\n    <div class=\"se-main-container\">\n                <div class=\"se-component se-image se-l-default\" id=\"SE-ecabf593-9c57-477d-ac05-72c511aecdeb\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:800px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-ecabf593-9c57-477d-ac05-72c511aecdeb\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA2MTJfNjEg/MDAxNzQ5NzI0NTkyOTMw.vrkIC2g2DZJd502jtBfKROmhZFoU5GbxsfyQV9C-Ap4g.DA-0RqL3zjU43cy5xA7tuFuxBq5ELtLS77Key7pzHckg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\", \"originalWidth\" : \"800\", \"originalHeight\" : \"236\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://nng-phinf.pstatic.net/MjAyNTA2MTJfNjEg/MDAxNzQ5NzI0NTkyOTMw.vrkIC2g2DZJd502jtBfKROmhZFoU5GbxsfyQV9C-Ap4g.DA-0RqL3zjU43cy5xA7tuFuxBq5ELtLS77Key7pzHckg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_800x236.png?type=w1678\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-ecabf593-9c57-477d-ac05-72c511aecdeb\", \"data\": {\"ctype\": \"image\" }}'></script>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-aa081752-9592-4ef6-806a-dc1d5ad87110\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-98127c45-d7e8-4b06-9b0d-3713ef93f670\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-d824ed34-83d9-4111-be0c-b9794f108738\">안녕하세요. </span><span style=\"color:#0078cb;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-32085d5b-fdcf-4658-983a-05a4a1c04023\"><b>승리의 여신: 니케</b></span><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-887c03af-0316-46c8-b499-32d8b9b2f3e7\">입니다.​​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a963e38d-6850-4d3b-8a59-45965f990b43\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b358221e-8b6a-4b4a-af81-5ba45abe3bf1\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e6cece02-f9bc-4b7e-ad78-95ea869dab29\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-567e2923-1128-44ff-aed0-132f99b453a1\">6/12(목) 20:30 ~ 22:30 경에 무점검 업데이트 및</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6f9455b2-9508-4dec-935b-74eda66b8256\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4d1d6116-b6c8-459c-bfce-6082ab324eb1\">업데이트 리소스 다운로드가 진행되었습니다.​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b8d6bbc4-4e2c-4ec8-b0d3-8acb5674f7c1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4889cec7-6b58-4c72-a7e5-61769dfcb32c\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e5dbc680-c318-41dc-8410-11c59e09ceda\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-3f0d5ae4-ad7d-4421-bdec-53db029e2160\">게임을 완전히 종료하신 후 재접속하여</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-87430260-5608-46be-830e-f6e98335e863\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-804a3399-7dc6-4dbf-a73a-914f40c3ba40\">업데이트 리소스를 다운로드해 주시기 바랍니다.​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-94f195eb-203b-4ec7-9cfe-06de8e51da1d\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-8c1e75e2-a08f-413a-9566-f88c8e92717a\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0b120793-be2d-40cc-94bc-bdc3bce1368c\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-e3826d75-fd42-42b6-9108-e7709b600d83\">​​자세한 설명은 아래를 확인해 주시기 바랍니다.​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-31398915-bf51-4d3a-8420-674521b92e56\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a3e06aed-7114-4349-ac69-586d9845c934\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bbc96014-15f0-4281-9cf6-8c70c19304ff\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4d9d9911-201d-4ce6-a509-ef628931f550\">​·····················································································</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-6fa56c6f-1f0a-4343-b3bd-c918fc74c333\"><span style=\"color:#000000;\" class=\"se-fs- se-ff-nanumgothic   \" id=\"SE-fabc64f2-756e-4b3a-824c-313bad713f68\"><b>📢 6월 12일(목) 무점검 업데이트 안내​​​​​​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-96e29e01-d56d-4369-aaee-84dcb4effefe\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a72e6d7d-4cd4-4cb4-bc68-5cc6c895f7d9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b48d4925-be74-4ecc-9144-546ad816737e\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-197ab7c3-7114-42a4-988b-47b2d566af64\"><b>​✔️ 일시</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-376ce5b2-a027-4835-a162-f85fe7f81373\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-bf0ca024-d1d0-497f-a06b-c3dbea235d0c\">- 6/12(목) 20:30 ~ 22:30 경​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-89503d12-9e90-4e08-814c-3ed405093dee\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-2074c94e-2913-4b91-a85a-1340e4e6c8fa\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-34cf8b6e-364c-4a98-98bc-acb1e8cd0ee1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-34c979ae-bdd9-4afe-b147-9d8a8a17cda5\"><b>​✔️ 내용</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e4c6259d-f2a3-4984-ab0a-a6f74c318ad3\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-cb648ce9-6bc8-4a07-8879-7daef7c452d8\">1. 센티 : 오션 리페어 SD모델의 장신구 표현을 스탠딩과 동일하게 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c971a075-6fa8-4e4a-8806-e2631c9ea1e0\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-308d6e30-c515-4f7e-a819-7d4ec0d81145\">2. 뷰 모드에서 코스튬 전환 시 의도와 다른 효과음이 재생되는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-703e34f0-82b8-41e1-b151-8c8056864983\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-32eaad20-14c1-43e3-acf2-d34e30ba04b7\">3. 상담 중 리틀 머메이드 - 어비스 플라워의 등장 위치가 어색한 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0cf06ce5-f4a4-4bad-9c96-23511248f5e2\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-b4f40a86-d71a-4399-8836-d94bcc44d13b\">4. 미니 게임 NAYTIBA RAID에서 아이템 구매 업적의 완료 조건을 하향 조정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2038e75c-f867-4616-86eb-857224bae1f9\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-750c49e5-99a5-4ef0-87ae-a878df98aee9\">5. MEMORIES TELLER 이벤트 필드 진입 시 특정 상황에서 일정과 다른 미션 패스 배너가 일시적으로 보이는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b23d54ca-2b9d-441a-a877-d26a8c6e6a67\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5cbe38cb-9c3a-4a99-9e07-f43c6a990078\">6. 중국어, 태국어, 프랑스어 환경에서 미니 게임 NAYTIBA RAID의 일부 몬스터 이름이 표시되지 않는 현상을 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3872dc77-6e42-486b-91cf-d71ad3f43230\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-85826309-a6c8-49a8-897f-cdbe2c4d7caf\">7. 일부 언어의 로컬라이징 이슈를 수정하였습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-33d7032c-d940-4ad8-8b36-8d0f860edcc1\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-625cc097-169d-4403-984c-6fdd505adb05\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-db607d2c-eafb-45c9-8f2a-2a1b96fdfd40\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-a00bebc8-7bcd-4827-bb7d-e763cc8435f1\">​​​※ 게임 재접속 후 업데이트 리소스 다운로드를 부탁드립니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9b07e77c-eb19-4395-8561-205620055529\"><span style=\"color:#ba0000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-6d07d856-bb0f-4c37-8ce4-9d92dcf18f98\">​※ 인앱 구매(확률형 아이템 포함)​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c9817c7a-9e76-47ea-8f54-27d61e3ca528\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-4f93c8c1-6652-4233-b006-e4f0de6ec9bc\">·····················································································​​​​​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-85b70a5b-c6be-49ea-8895-d1106d4cfc89\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-5c55aec1-c425-42bb-8fb3-60dc52eba537\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4c3cca18-703c-41bb-a004-effab8807f1a\"><span style=\"color:#000000;\" class=\"se-fs-fs13 se-ff-nanumgothic   \" id=\"SE-e38ea6b7-ed8c-4448-b505-c7c6591e2782\">게임 이용에 불편을 끼쳐 드려 죄송합니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_text\", \"id\": \"SE-aa081752-9592-4ef6-806a-dc1d5ad87110\", \"data\": {\"ctype\": \"text\"  }}'></script>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-34554f72-c8f5-4397-93be-5fafdd4cf64d\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:100px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-34554f72-c8f5-4397-93be-5fafdd4cf64d\", \"src\" : \"https://nng-phinf.pstatic.net/MjAyNTA2MTJfMjgg/MDAxNzQ5NzI0Njg2Mzk5.XjbHSqRCrqVpgf0vwRWe8t-tCHXVaB9-ngvmcbFM09Eg.VXyFezynm4ZT0M5Iu5lflut_4j9srOudpLD9wgJr_9wg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_100x100.png?type=w1678\", \"originalWidth\" : \"100\", \"originalHeight\" : \"100\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://nng-phinf.pstatic.net/MjAyNTA2MTJfMjgg/MDAxNzQ5NzI0Njg2Mzk5.XjbHSqRCrqVpgf0vwRWe8t-tCHXVaB9-ngvmcbFM09Eg.VXyFezynm4ZT0M5Iu5lflut_4j9srOudpLD9wgJr_9wg.PNG/241030_%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8_100x100.png?type=w1678\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                    <script type=\"text/data\" class=\"__se_module_data\" data-module-v2='{\"type\": \"v2_image\", \"id\": \"SE-34554f72-c8f5-4397-93be-5fafdd4cf64d\", \"data\": {\"ctype\": \"image\" }}'></script>\n                </div>\n    </div>\n</div>\n"
