name = "collection-kit-forecast-collector"
main = "src/worker.ts"
compatibility_date = "2026-08-14"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[observability.logs]
enabled = true
invocation_logs = true

[triggers]
crons = ["*/3 * * * *"]

[[ratelimits]]
name = "ADMIN_RATE_LIMITER"
namespace_id = "419001"

  [ratelimits.simple]
  limit = 60
  period = 60

[[d1_databases]]
binding = "FORECAST_DB"
database_name = "collection-kit-forecast-collector"
database_id = "replace-with-production-d1-id"

[vars]
ENVIRONMENT = "production"
DEPLOY_SHA = "local"
POLL_MODE = "both"
DISCORD_APPROVAL_MODE = "disabled"

[secrets]
required = ["ADMIN_TOKEN"]

[env.staging]
name = "collection-kit-forecast-collector-staging"
workers_dev = true

[[env.staging.ratelimits]]
name = "ADMIN_RATE_LIMITER"
namespace_id = "419002"

  [env.staging.ratelimits.simple]
  limit = 60
  period = 60

[[env.staging.d1_databases]]
binding = "FORECAST_DB"
database_name = "collection-kit-forecast-collector-staging"
database_id = "replace-with-staging-d1-id"

[env.staging.vars]
ENVIRONMENT = "staging"
DEPLOY_SHA = "local"
POLL_MODE = "both"
DISCORD_APPROVAL_MODE = "test"

[env.staging.secrets]
required = ["ADMIN_TOKEN"]
