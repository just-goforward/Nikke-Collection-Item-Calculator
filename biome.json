{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json}",
      "shared/**/*.{ts,tsx,js,jsx,json}",
      "!shared/generated",
      "scripts/**/*.{ts,tsx,js,jsx,json,mjs}",
      "cloudflare/src/**/*.ts",
      "cloudflare/package.json",
      "cloudflare/vitest.config.ts",
      "forecast-collector/**/*.{ts,json}",
      "!forecast-collector/worker-configuration.d.ts",
      "forecast-dispatcher/**/*.{ts,json}",
      "!forecast-dispatcher/worker-configuration.d.ts",
      "forecast-interactions/**/*.{ts,json}",
      "!forecast-interactions/worker-configuration.d.ts",
      "usage-guard/**/*.{ts,json}",
      "!usage-guard/worker-configuration.d.ts",
      "stats-observer/**/*.{ts,json}",
      "!stats-observer/worker-configuration.d.ts",
      "e2e/**/*.ts",
      "benchmarks/**/*.{ts,tsx,js,jsx,json,md}",
      "vite.config.ts",
      "vitest.config.ts",
      "vitest.benchmark.config.ts",
      "playwright*.config.ts",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "tsconfig.e2e.json",
      "cloudflare/tsconfig.json",
      "forecast-collector/tsconfig.json",
      "forecast-dispatcher/tsconfig.json",
      ".github/workflows/*.yml",
      "!**/node_modules",
      "!dist",
      "!**/.wrangler",
      "!test-results",
      "!playwright-report",
      "!playwright/.cache",
      "!package-lock.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "e2e/**", "playwright*.config.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
