{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,js,jsx,json}",
      "cloudflare/src/**/*.ts",
      "e2e/**/*.ts",
      "benchmarks/**/*.{ts,tsx,js,jsx,json,md}",
      "vite.config.ts",
      "vitest.config.ts",
      "vitest.cloudflare.config.ts",
      "vitest.benchmark.config.ts",
      "playwright.config.ts",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "cloudflare/tsconfig.json",
      ".github/workflows/*.yml",
      "!**/node_modules",
      "!dist",
      "!**/.wrangler",
      "!test-results",
      "!playwright-report",
      "!playwright/.cache",
      "!package-lock.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
