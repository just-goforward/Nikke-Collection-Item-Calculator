{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "collection-kit-calculator-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
