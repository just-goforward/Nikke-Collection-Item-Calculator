    "test:forecast-collector": "pnpm --filter @collection-kit/forecast-collector run test",
    "test:forecast-dispatcher": "pnpm --filter @collection-kit/forecast-dispatcher run test",
    "test:forecast-interactions": "pnpm --filter @collection-kit/forecast-interactions run test",
