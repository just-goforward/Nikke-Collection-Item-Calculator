    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "knip": "^6.47.0",
    "miniflare": "5.20261119.0-beta",
    "oxc-parser": "^0.159.0",
    "parse5": "8.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  }
