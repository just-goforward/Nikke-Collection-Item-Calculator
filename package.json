    "personal-data:types:check": "wrangler types personal-data/worker-configuration.d.ts --config personal-data/wrangler.toml --env-interface GeneratedPersonalDataEnv --strict-vars false --check",
    "typecheck": "pnpm run worker:types:check && pnpm run forecast:types:check && pnpm run dispatcher:types:check && pnpm run interactions:types:check && pnpm run typecheck:interactions-staging && pnpm run admin:types:check && pnpm run usage-guard:types:check && pnpm run stats-observer:types:check && pnpm run personal-data:types:check && tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json && tsc --noEmit -p forecast-collector/tsconfig.json && tsc --noEmit -p forecast-dispatcher/tsconfig.json && tsc --noEmit -p forecast-interactions/tsconfig.json && tsc --noEmit -p forecast-admin/tsconfig.json && tsc --noEmit -p usage-guard/tsconfig.json && tsc --noEmit -p stats-observer/tsconfig.json && pnpm --filter @collection-kit/personal-data run typecheck && tsc --noEmit -p tsconfig.e2e.json",
