    "@cloudflare/vitest-plugin": "1.9.0",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@tailwindcss/vite": "^4.3.5",
