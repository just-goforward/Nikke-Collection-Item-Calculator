    "clean:artifacts:dry-run": "node scripts/clean-artifacts.ts",
    "clean:research-artifacts": "node scripts/clean-artifacts.ts --research --apply",
    "clean:research-artifacts:dry-run": "node scripts/clean-artifacts.ts --research"
