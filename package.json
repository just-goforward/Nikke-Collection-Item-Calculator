{
  "name": "collection-kit-calculator",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "cloudflare",
    "forecast-collector",
    "forecast-dispatcher",
    "forecast-interactions",
    "personal-data",
    "stats-observer",
    "usage-guard"
  ],
  "engines": {
    "node": ">=24.22.1 <25 || >=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "dev:current-ui-certified": "vite --configLoader native --mode current-ui-certified-local --host 127.0.0.1 --port 4317 --strictPort",
    "prebuild": "npm run build:certified-wasm && npm run check:certified-engine-build && npm run build:solver-wasm",
    "build:certified-wasm": "node scripts/build-certified-wasm.ts",
    "rebuild:certified-wasm": "node scripts/build-certified-wasm.ts --rebuild && npm run generate:certified-engine-build",
    "build": "vite build --configLoader native",
    "build:site-staging": "node scripts/build-site-staging.ts --build",
    "build:site-production": "node scripts/build-production-service.mjs",
    "build:site-production-off": "node scripts/build-production-off-service.mjs",
    "check:site-production-off": "node --input-type=module -e \"const {buildSiteProduction}=await import('./scripts/build-site-production.ts'); const {assertProductionOffSiteProfile}=await import('./scripts/site-deployment-artifact.mjs'); await buildSiteProduction('dist',true); await assertProductionOffSiteProfile('dist',process.argv[1]);\"",
    "check:site-production": "node scripts/build-site-production.ts --check",
    "smoke:site-production-deployed": "node scripts/smoke-site-production.mjs",
    "deploy:site-staging": "node scripts/deploy-site.ts staging",
    "deploy:site-production": "node scripts/deploy-site.ts production",
    "deploy:site-production-off": "node scripts/deploy-site.ts production-off",
    "deploy:site-rebuild-production": "node scripts/deploy-site.ts rebuild-production",
    "deploy:site-rebuild-staging": "node scripts/deploy-site.ts rebuild-staging",
    "deploy:stats-rebuild-production": "node scripts/deploy-stats.ts rebuild-production",
    "deploy:stats-rebuild-staging": "node scripts/deploy-stats.ts rebuild-staging",
    "check:site-staging": "node scripts/build-site-staging.ts --check",
    "prebuild:solver-wasm": "npm run generate:supply-forecast",
    "build:solver-wasm": "node scripts/build-solver-wasm.ts",
    "build:solver-wasm:branch-bound": "node scripts/build-solver-wasm-branch-bound.ts",
    "build:solver-wasm:sparse-pi": "node scripts/build-solver-wasm-sparse-pi.ts",
    "preview": "vite preview --configLoader native",
    "generate:certified-staging-approved-panel": "node scripts/generate-certified-staging-approved-panel.ts",
    "dry-run:certified-staging-approved-panel-v10": "node scripts/certified-staging-approved-panel/v10/dry-run.ts",
    "dry-run:certified-staging-approved-panel-v11": "node scripts/certified-staging-approved-panel/v11/dry-run.ts",
    "test": "vitest run --configLoader runner --exclude scripts/certified-staging-oracle-endpoints-integer.spec.ts",
    "test:worker": "npm run test --workspace @collection-kit/stats-worker",
    "test:forecast-collector": "npm run test --workspace @collection-kit/forecast-collector",
    "test:forecast-dispatcher": "npm run test --workspace @collection-kit/forecast-dispatcher",
    "test:forecast-interactions": "npm run test --workspace @collection-kit/forecast-interactions",
    "test:forecast-admin": "vitest run --configLoader runner --config forecast-admin/vitest.config.ts && vitest run --configLoader runner --config forecast-admin/vitest.node.config.ts",
    "test:forecast-admin-e2e": "playwright test --config scripts/playwright-forecast-admin.config.ts",
    "test:usage-guard": "npm run test --workspace @collection-kit/usage-guard",
    "test:stats-observer": "npm run test --workspace @collection-kit/stats-observer",
    "test:personal-data": "npm run test --workspace @collection-kit/personal-data",
    "test:workers": "npm run test:worker && npm run test:forecast-collector && npm run test:forecast-dispatcher && npm run test:forecast-interactions && npm run test:usage-guard && npm run test:stats-observer && npm run test:personal-data && npm run test:forecast-admin",
    "test:mutation": "stryker run",
    "test:bench": "vitest run --config vitest.benchmark.config.ts --configLoader runner",
    "bench:next-solver:webgpu-frontier": "node scripts/run-webgpu-frontier-study.ts",
    "bench:next-solver:webgpu-android": "node scripts/smoke-webgpu-frontier-android.ts",
    "bench:solver-runtime:ci": "node scripts/bench-solver-runtime-ci.ts",
    "bench:wasm-candidate:browser": "node scripts/bench-wasm-candidate-browser.ts",
    "bench:wasm-candidate": "node scripts/bench-wasm-candidate.ts",
    "bench:wasm-opt": "node scripts/bench-wasm-opt.ts",
    "bench:worker-concurrency": "node scripts/bench-worker-concurrency.ts",
    "test:coverage": "vitest run --configLoader runner --coverage --exclude scripts/certified-staging-oracle-endpoints-integer.spec.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "pretest:alignment": "npm run build",
    "test:alignment": "playwright test --config playwright.alignment.config.ts",
    "pretest:visual": "npm run build",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots=all",
    "worker:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.toml --env= --env-interface GeneratedWorkerEnv --strict-vars false",
    "validate:certified-staging:waiting-cache": "node --max-old-space-size=768 scripts/validate-certified-staging-waiting-cache.ts",
    "validate:wasm-candidate": "node scripts/validate-wasm-candidate.ts",
    "smoke:wasm-candidate:android": "node scripts/smoke-wasm-candidate-android.ts",
    "smoke:stats-worker": "node scripts/smoke-stats-worker.ts",
    "smoke:forecast-collector": "node scripts/smoke-forecast-collector.ts",
    "smoke:forecast-dispatcher": "node scripts/smoke-forecast-dispatcher.ts",
    "smoke:forecast-interactions": "node scripts/smoke-forecast-interactions.ts",
    "send:forecast-router-test": "node scripts/send-forecast-router-test.ts",
    "smoke:discord-forecast-routing": "node scripts/discord-forecast-routing-smoke.ts",
    "check:cloudflare-cron-capacity": "node scripts/cloudflare-cron-capacity.ts",
    "check:d1-budget": "node scripts/cloudflare-d1-budget.ts",
    "dispatch:pages-verification": "node scripts/dispatch-pages-verification.ts",
    "check:forecast-canary": "node scripts/check-forecast-canary.ts",
    "check:workflows": "node scripts/check-workflow-hardening.ts",
    "collect:forecast-runtime": "node scripts/cloudflare-workers-observability.ts collect",
    "preflight:forecast-runtime": "node scripts/cloudflare-workers-observability.ts preflight",
    "check:stats-observer-canary": "node scripts/check-stats-observer-canary.ts",
    "peek:supply-forecast": "node scripts/peek-supply-forecast.ts",
    "check:d1-schema": "node scripts/check-d1-schema.ts",
    "smoke:pages": "node scripts/smoke-pages-deployment.mjs",
    "worker:types:check": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.toml --env= --env-interface GeneratedWorkerEnv --strict-vars false --check",
    "forecast:types": "wrangler types forecast-collector/worker-configuration.d.ts --config forecast-collector/wrangler.toml --env= --env-interface GeneratedForecastCollectorEnv --strict-vars false",
    "forecast:types:check": "wrangler types forecast-collector/worker-configuration.d.ts --config forecast-collector/wrangler.toml --env= --env-interface GeneratedForecastCollectorEnv --strict-vars false --check",
    "dispatcher:types": "wrangler types forecast-dispatcher/worker-configuration.d.ts --config forecast-dispatcher/wrangler.toml --env= --env-interface GeneratedForecastDispatcherEnv --strict-vars false",
    "dispatcher:types:check": "wrangler types forecast-dispatcher/worker-configuration.d.ts --config forecast-dispatcher/wrangler.toml --env= --env-interface GeneratedForecastDispatcherEnv --strict-vars false --check",
    "interactions:types": "wrangler types forecast-interactions/worker-configuration.d.ts --config forecast-interactions/wrangler.toml --env= --env-interface GeneratedForecastInteractionsEnv --strict-vars false",
    "interactions:types:check": "wrangler types forecast-interactions/worker-configuration.d.ts --config forecast-interactions/wrangler.toml --env= --env-interface GeneratedForecastInteractionsEnv --strict-vars false --check",
    "interactions:staging:types": "wrangler types forecast-interactions/.wrangler/staging-worker-configuration.d.ts --config forecast-interactions/staging.wrangler.toml --env= --env-interface GeneratedStagingForecastInteractionsEnv --strict-vars false",
    "typecheck:interactions-staging": "npm run interactions:staging:types && tsc --noEmit -p forecast-interactions/tsconfig.staging.json",
    "deploy:forecast-interactions-staging": "wrangler deploy --config forecast-interactions/staging.wrangler.toml",
    "admin:types": "wrangler types forecast-admin/worker-configuration.d.ts --config forecast-admin/wrangler.toml --env-interface GeneratedForecastAdminEnv --strict-vars false",
    "admin:types:check": "wrangler types forecast-admin/worker-configuration.d.ts --config forecast-admin/wrangler.toml --env-interface GeneratedForecastAdminEnv --strict-vars false --check",
    "typecheck:forecast-admin": "npm run admin:types:check && tsc --noEmit -p forecast-admin/tsconfig.json",
    "usage-guard:types": "wrangler types usage-guard/worker-configuration.d.ts --config usage-guard/wrangler.toml --env-interface GeneratedUsageGuardEnv --strict-vars false",
    "usage-guard:types:check": "wrangler types usage-guard/worker-configuration.d.ts --config usage-guard/wrangler.toml --env-interface GeneratedUsageGuardEnv --strict-vars false --check",
    "stats-observer:types": "wrangler types stats-observer/worker-configuration.d.ts --config stats-observer/wrangler.toml --env-interface GeneratedStatsObserverEnv --strict-vars false",
    "stats-observer:types:check": "wrangler types stats-observer/worker-configuration.d.ts --config stats-observer/wrangler.toml --env-interface GeneratedStatsObserverEnv --strict-vars false --check",
    "personal-data:types": "wrangler types personal-data/worker-configuration.d.ts --config personal-data/wrangler.toml --env-interface GeneratedPersonalDataEnv --strict-vars false",
    "personal-data:types:check": "wrangler types personal-data/worker-configuration.d.ts --config personal-data/wrangler.toml --env-interface GeneratedPersonalDataEnv --strict-vars false --check",
    "typecheck": "npm run worker:types:check && npm run forecast:types:check && npm run dispatcher:types:check && npm run interactions:types:check && npm run typecheck:interactions-staging && npm run admin:types:check && npm run usage-guard:types:check && npm run stats-observer:types:check && npm run personal-data:types:check && tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json && tsc --noEmit -p forecast-collector/tsconfig.json && tsc --noEmit -p forecast-dispatcher/tsconfig.json && tsc --noEmit -p forecast-interactions/tsconfig.json && tsc --noEmit -p forecast-admin/tsconfig.json && tsc --noEmit -p usage-guard/tsconfig.json && tsc --noEmit -p stats-observer/tsconfig.json && npm run typecheck --workspace @collection-kit/personal-data && tsc --noEmit -p tsconfig.e2e.json",
    "generate:forecast-test-schema": "node scripts/generate-forecast-v27-test-schema.ts",
    "generate:supply-forecast": "node scripts/supply-forecast-codegen.ts",
    "derive:certified-v5-local-forecast": "node scripts/derive-certified-local-policy.ts",
    "check:supply-forecast": "node scripts/supply-forecast-codegen.ts --check",
    "lint": "npm run check:certified-engine-build && npm run check:supply-forecast && npm run check:workflows && npm run check:test-runtimes && biome check --diagnostic-level=warn && npm run lint:architecture && npm run lint:unused",
    "lint:advisory": "biome check --diagnostic-level=info --max-diagnostics=none",
    "lint:architecture": "node scripts/check-architecture.ts",
    "check:test-runtimes": "node scripts/check-test-runtime-boundaries.ts",
    "lint:unused": "knip",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "report:bundle": "node scripts/report-bundle.ts",
    "check:bundle-budget": "node scripts/check-bundle-budget.ts",
    "generate:rust-wasm-licenses": "node scripts/rust-wasm-licenses.ts --write",
    "check:rust-wasm-licenses": "node scripts/rust-wasm-licenses.ts --check",
    "lint:rust": "cargo fmt --manifest-path rust/solver-rs/Cargo.toml --check && cargo clippy --manifest-path rust/solver-rs/Cargo.toml --target wasm32-unknown-unknown -- -D warnings",
    "perf:fonts": "node scripts/compare-font-loading.mjs",
    "generate:og": "npm run build && node scripts/generate-og-images.ts",
    "clean:artifacts": "node scripts/clean-artifacts.ts --dry-run",
    "clean:artifacts:dry-run": "node scripts/clean-artifacts.ts --dry-run",
    "clean:research-artifacts": "node scripts/clean-artifacts.ts --dry-run",
    "clean:research-artifacts:dry-run": "node scripts/clean-artifacts.ts --dry-run",
    "pretest": "npm run build:certified-wasm && node scripts/prepare-certified-staging-oracle-cache.ts",
    "pretest:certified-endpoints": "node scripts/prepare-certified-staging-oracle-cache.ts",
    "test:certified-endpoints": "vitest run --configLoader runner scripts/certified-staging-oracle-endpoints-integer.spec.ts --maxWorkers=1",
    "pretest:certified-runtime": "npm run build:certified-wasm",
    "test:certified-runtime": "node --test src/certifiedRuntime/nodeRuntime.test.mjs",
    "test:certified-ui": "playwright test e2e/certified-ui.spec.ts",
    "test:forecast-runtime": "playwright test --config scripts/playwright-forecast.config.ts",
    "generate:certified-engine-build": "node scripts/certified-local-forecast.ts && node scripts/certified-engine-build.ts",
    "check:certified-engine-build": "node scripts/certified-engine-build.ts --check",
    "pretest:coverage": "npm run build:certified-wasm && node scripts/prepare-certified-staging-oracle-cache.ts",
    "clean:artifacts:apply": "node scripts/clean-artifacts.ts --apply",
    "typecheck:operations": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.operations.json",
    "test:operations": "node --test scripts/operational-boundary.test.mjs scripts/local-service-profile.test.mjs scripts/site-target-html.test.mjs scripts/site-gateway-preflight.test.mjs scripts/production-off-artifact.test.mjs",
    "generate:production-operations": "node scripts/render-production-operations.mjs --write",
    "check:production-operations": "node scripts/render-production-operations.mjs --check",
    "build:operations": "node scripts/build-local-service.mjs",
    "typecheck:research": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "knip": "^6.44.0",
    "miniflare": "5.20261019.1-beta",
    "oxc-parser": "^0.156.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "ajv@8.20.0": {
      "fast-uri": "3.1.9"
    },
    "typed-rest-client@2.3.1": {
      "qs": "6.17.1"
    },
    "miniflare@5.20261019.1-beta": {
      "undici": "7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
