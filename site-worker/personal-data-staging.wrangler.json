{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "collection-kit-personal-data-local",
  "main": "../personal-data/src/worker.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "env": {
    "staging": {
      "name": "collection-kit-personal-data-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "SITE_ORIGIN": "https://staging.nikkecollection.com",
        "PUBLICATION_ENABLED": "false",
        "PRIVACY_RECONCILE_QUIESCENT": "false"
      },
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "PERSONAL_DB",
          "database_name": "collection-kit-personal-data-staging",
          "database_id": "ac5ecc1c-6c6b-43e8-b5c9-82af4e25f989",
          "migrations_dir": "../personal-data/migrations/personal"
        },
        {
          "binding": "PRIVACY_CONTROL_DB",
          "database_name": "collection-kit-privacy-control-staging",
          "database_id": "dcee0896-ee5c-4e0f-b5c8-e4632963e2e1",
          "migrations_dir": "../personal-data/migrations/privacy"
        },
        {
          "binding": "PUBLIC_AGGREGATE_DB",
          "database_name": "collection-kit-public-aggregate-staging",
          "database_id": "343d3046-4da4-4836-ae72-d914dc9a6349",
          "migrations_dir": "../personal-data/migrations/public"
        }
      ]
    }
  }
}
